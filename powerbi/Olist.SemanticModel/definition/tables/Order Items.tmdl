table 'Order Items'
	lineageTag: 86f59b22-b5b7-440a-a6f1-88bdd9dc8d21

	measure 'Product Sales' = SUM('Order Items'[price])
		formatString: "R$" #,##0.00
		displayFolder: KPIs
		lineageTag: 2506fad0-5101-4de2-9b15-712aab3e1775

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Items Sold' = COUNTROWS('Order Items')
		formatString: 0
		displayFolder: KPIs
		lineageTag: f2113edd-1f17-4e23-ac24-e08a2358789e

	measure 'Freight Value' = SUM('Order Items'[freight_value])
		formatString: "R$" #,##0.00
		displayFolder: KPIs
		lineageTag: ee65c200-2fd9-4cb4-8b00-93c13b7009aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Fulfillments = DISTINCTCOUNT('Order Items'[order_id])
		formatString: 0
		displayFolder: KPIs
		lineageTag: e2dc29b9-6a86-4caa-a3ba-c1b48977345a

	measure Revenue = [Product Sales] + [Freight Value]
		formatString: "R$" #,##0.00
		displayFolder: KPIs
		lineageTag: 926525a5-2c0e-42b3-bd0e-f612652ea998

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Fulfillment Value' = DIVIDE([Product Sales], [Fulfillments])
		formatString: "R$" #,##0.00
		displayFolder: KPIs
		lineageTag: 4ede2136-3ae5-4f52-9cca-631f7bcd7068

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Sales MoM%' =
			
			VAR PreviousMonthSales =
			    CALCULATE(
			        [Product Sales],
			        DATEADD('Date'[full_date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(
			        [Product Sales] - PreviousMonthSales,
			        PreviousMonthSales
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: KPIs
		lineageTag: 1a19d434-1c9c-4988-b0f1-809ba521c59d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MonthOverMonth"
				}

		changedProperty = FormatString

	measure 'Product Sales PY' =
			
			CALCULATE(
			    [Product Sales],
			    SAMEPERIODLASTYEAR('Date'[full_date])
			)
		formatString: "R$" #,##0.00
		displayFolder: KPIs
		lineageTag: 73710869-25bb-428b-949b-bb151a2a8277

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Sales YoY Change' =
			
			IF(
			    ISBLANK([Product Sales PY]),
			    BLANK(),
			    [Product Sales] - [Product Sales PY]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: KPIs
		lineageTag: 5460e213-1e06-428d-b58d-19371e3b526b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Product Sales YoY %' = DIVIDE([Product Sales] - [Product Sales PY], [Product Sales PY])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: KPIs
		lineageTag: 63b51dae-3256-4fb5-8573-f1ce8dbd7cb9


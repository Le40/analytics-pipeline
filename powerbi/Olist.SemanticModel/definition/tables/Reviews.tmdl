table Reviews
	lineageTag: 495c67d7-bf48-448c-aef1-fe34d54530c3

	measure 'Positive Review %' = ```
			
			divide(
			    CALCULATE(
			        count('Reviews'[score]),  
			        'Reviews'[score] >=4
			    ) ,
			    CALCULATE(
			        [Review Count],
			        REMOVEFILTERS('Reviews'[score])
			))
			```
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: KPIs
		lineageTag: 83738802-0e36-4e7a-8f6b-210c840b5e40

	measure 'Avg Review Score' = AVERAGE('Reviews'[score])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: 706fa3fa-52d3-47e5-a78e-550976f1ee77

	measure 'Negative Review %' =
			
			divide(
			    [Negative Reviews],
			    CALCULATE(
			        [Review Count],
			        REMOVEFILTERS('Reviews'[score])
			    )
			)
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: KPIs
		lineageTag: d28abb7b-bf1f-4c87-8e2b-e2a354fa1cc8

	measure 'Negative Review % by Delivery' = ```
			
			VAR OrderIds = VALUES('Orders'[order_id])
			
			RETURN 
			    CALCULATE(
			        [Negative Review %],
			        TREATAS(
			            OrderIds,
			            'Reviews'[order_id]
			        )
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery Analysis
		lineageTag: aa1e236d-5944-4c03-8b51-02ec2bd79dcc

	measure 'Negative Reviews' =
			
			CALCULATE(
			    COUNT('Reviews'[score]),
			    'Reviews'[score] <= 2
			)
		formatString: 0
		displayFolder: KPIs
		lineageTag: a98800a3-6e94-4248-816c-ff993a76c2f2

	measure 'Negative Reviews by Delivery' = ```
			
			VAR OrderIds = VALUES('Orders'[order_id])
			
			RETURN 
			    CALCULATE(
			        [Negative Reviews],
			        TREATAS(
			            OrderIds,
			            'Reviews'[order_id]
			        )
			    )
			```
		formatString: 0
		displayFolder: Delivery Analysis
		lineageTag: b3c15c0d-627c-4648-9473-294add84ec19

	measure 'Review Count' = COUNTROWS('Reviews')
		formatString: 0
		displayFolder: KPIs
		lineageTag: d1d11d0b-4028-4a16-b968-21f9055cc123

	measure 'Reviewed Orders' = DISTINCTCOUNT('Reviews'[order_id])
		formatString: 0
		displayFolder: KPIs
		lineageTag: 317b8f97-61ce-4067-a3e4-4017dc132cb3

	measure 'Avg Delivery Days by Rating' =
			
			VAR ReviewedOrders = VALUES('Reviews'[order_id])
			RETURN
			    CALCULATE(
			        [Avg Delivery Days],
			        TREATAS(ReviewedOrders, 'Orders'[order_id]
			    )
			)
		formatString: " 0.0 ""Days"""
		displayFolder: Delivery Analysis
		lineageTag: 5f51eeb2-5354-4344-80ca-3d15cbe304f2

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Late Delivery Rate by Rating' =
			
			VAR ReviewedOrders = VALUES('Reviews'[order_id])
			RETURN
			    CALCULATE(
			        [Late Delivery Rate],
			        TREATAS(ReviewedOrders, 'Orders'[order_id]
			    )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Delivery Analysis
		lineageTag: 1ac47aab-85c0-466c-9223-73db901811c5

	measure 'Review Coverage %' =
			
			VAR AllOrders = VALUES('Orders'[order_id])
			RETURN
			    DIVIDE(
			        CALCULATE(
			            [Reviewed Orders],
			            REMOVEFILTERS('Date'),
			            REMOVEFILTERS('Reviews'[score]),
			            TREATAS(AllOrders, 'Reviews'[order_id])
			        ),
			        DISTINCTCOUNT('Orders'[order_id])
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: KPIs
		lineageTag: f33d43ce-1b1c-498d-9c8a-64449c94f3a5


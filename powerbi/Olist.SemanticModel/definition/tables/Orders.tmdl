	column 'Delivery Days' =
			
			IF(
			    NOT ISBLANK('Orders'[delivery_date_key]),
			    DATEDIFF(
			        'Orders'[purchase_timestamp],
			        'Orders'[customer_delivery_timestamp],
			        MINUTE
			    ) / 1440
			)
		dataType: decimal
		formatString: " 0.0 ""Days"""
		displayFolder: Delivery
		lineageTag: b479c463-97a7-4a7f-9cb1-dfb1a4a2091e
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Shipping Days' =
			
			IF(
			    NOT ISBLANK('Orders'[delivery_date_key]),
			    DATEDIFF(
			        'Orders'[carrier_delivery_timestamp],
			        'Orders'[customer_delivery_timestamp],
			        MINUTE
			    ) / 1440
			)
		dataType: decimal
		formatString: " 0.0 ""Days"""
		displayFolder: Delivery
		lineageTag: 04697bd6-529e-4099-be68-7c302db0a4ce
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Carrier Delivery' =
			
			IF(
			    NOT ISBLANK('Orders'[delivery_date_key]),
			    DATEDIFF(
			        'Orders'[purchase_timestamp],
			        'Orders'[carrier_delivery_timestamp],
			        MINUTE
			    ) / 1440
			)
		dataType: decimal
		formatString: " 0.0 ""Days"""
		displayFolder: Delivery
		lineageTag: 908de52e-3bac-435a-ad80-ed6dee2bc924
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Delivery Bucket' =
			
			VAR Days = 'Orders'[Delivery Days]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Days), BLANK(),
			    Days < 4, "0–3 days",
			    Days < 8, "4–7 days",
			    Days < 15, "8–14 days",
			    Days < 31, "15–30 days",
			    "31+ days"
			)
		displayFolder: Delivery
		lineageTag: 6353b571-942c-43df-a1ca-e817ecbc1f0e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Late Delivery' =
			
			VAR Actual = 'Orders'[customer_delivery_timestamp]
			VAR Estimated = 'Orders'[estimated_delivery_timestamp]
			RETURN
			IF(
			    'Orders'[status] <> "delivered" ||
			    ISBLANK(Actual) || ISBLANK(Estimated),
			    BLANK(),
			    IF(INT(Actual) > INT(Estimated), 1, 0)
			)
		isHidden
		formatString: 0
		displayFolder: Delivery
		lineageTag: 6362f8fd-c0d0-4f58-9194-3daa287366e4
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Est. Delivery Days' =
			
			IF(
			    NOT ISBLANK('Orders'[estimated_delivery_timestamp]),
			    DATEDIFF(
			        'Orders'[purchase_timestamp],
			        'Orders'[estimated_delivery_timestamp],
			        MINUTE
			    ) / 1440
			)
		dataType: decimal
		formatString: "  0.0 ""Days"""
		displayFolder: Delivery
		lineageTag: 34f5fe1c-9dd4-414c-a1bf-22564331b991
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Delivery Outcome' =
			
			VAR AsOfDate = DATE(2018, 09, 01)
			VAR OrderStatus = 'Orders'[status]
			VAR LateDelivery = 'Orders'[Late Delivery]
			RETURN
			SWITCH(
			    TRUE(),
			    OrderStatus = "canceled", "Cancelled",
			    OrderStatus = "unavailable", "Unavailable",
			    OrderStatus = "delivered" && LateDelivery = 1, "Late",
			    OrderStatus = "delivered" && LateDelivery = 0, "On Time",
			    OrderStatus = "delivered", "Missing Delivery Date",
			    ISBLANK('Orders'[estimated_delivery_timestamp]), "Unknown",
			    INT('Orders'[estimated_delivery_timestamp]) < AsOfDate, "Overdue",
			    "Pending"
			)
		displayFolder: Delivery
		lineageTag: d96c1d08-2176-4caf-b0db-e07e51e2f657
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

